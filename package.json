{
  "name": "magnifico-street-food",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tunnel.ps1",
    "build": "next build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed-magnifico.mjs",
    "seed:legacy": "node scripts/seed-menu.mjs",
    "db:push": "supabase db push",
    "backup:supabase": "node scripts/migration/backup-supabase.mjs",
    "prepare:d1-import": "node scripts/migration/prepare-d1-import.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.133.0"
  }
}
